[Unit]
Description=Sync remote MOE experiment tmux status JSON
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/yuli0398/Optimization/MOE-grad-conflict-routing
EnvironmentFile=-%h/.config/moe-experiment-status-sync.env
ExecStart=/usr/bin/env python3 /home/yuli0398/Optimization/MOE-grad-conflict-routing/scripts/sync_remote_experiment_status_json.py --host ${MOE_STATUS_REMOTE_HOST} --port ${MOE_STATUS_REMOTE_PORT} --user ${MOE_STATUS_REMOTE_USER} --password ${MOE_STATUS_REMOTE_PASSWORD} --remote-root ${MOE_STATUS_REMOTE_ROOT} --remote-output ${MOE_STATUS_REMOTE_JSON} --local-output ${MOE_STATUS_LOCAL_JSON}
